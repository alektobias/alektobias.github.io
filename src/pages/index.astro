---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/common/Footer.astro";
import HeroSection from "../components/home/HeroSection.astro";
import JourneySection from "../components/home/JourneySection.astro";
import SkillSets from "../components/home/SkillSets.astro";
import TimelineSection from "../components/home/TimelineSection.astro";
import ContactSection from "../components/home/ContactSection.astro";
---

<Layout
	title="Alek Tobias | Senior Full Stack Developer & Solution Architect"
	description="Senior Full Stack Engineer with 8+ years of experience. Specialist in the JavaScript ecosystem (Node, Bun, React) and AWS infrastructure."
	summary="Full Stack Engineer building and modernizing web systems, from startups to enterprise environments like TOTVS. Core stack: TypeScript, React, Next.js, Node.js, AWS."
>
	<main class="bg-background relative">
		<HeroSection lang="en" />
		<JourneySection lang="en" />
		<SkillSets lang="en" />
		<TimelineSection lang="en" />
		<ContactSection lang="en" />
	</main>

	<Footer lang="en" />
</Layout>
